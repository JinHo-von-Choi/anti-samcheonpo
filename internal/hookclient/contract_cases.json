{
  "version": 1,
  "note": "Hook transport contract. One spec, two implementations: the Go hook (internal/hookclient) and the Rust hook (crates/samcheonpo-hook) must both satisfy it. A case names the agent dialect, the event, the stdin, and what a fake daemon answers; expect states what the transport must print and report. The exit code is always 0: a failed PreToolUse hook is read as a denial by Copilot, and an unreadable permission object is read as a block by Cursor. expect_request is the request frame the Go transport puts on the wire with the deadline masked to 0: the two transports must send the same bytes.",
  "cases": [
    {
      "name": "claude-pretooluse-empty-stdin",
      "agent": "claude",
      "event": "PreToolUse",
      "daemon": "down",
      "stdin": "",
      "expect": { "exit_code": 0, "stdout": "", "status": "invalid_input", "response_received": false }
    },
    {
      "name": "claude-pretooluse-invalid-json",
      "agent": "claude",
      "event": "PreToolUse",
      "daemon": "up",
      "response": "{\"output\":null}",
      "stdin": "{not json",
      "expect": { "exit_code": 0, "stdout": "", "status": "invalid_input", "response_received": false }
    },
    {
      "name": "claude-pretooluse-daemon-down",
      "agent": "claude",
      "event": "PreToolUse",
      "daemon": "down",
      "stdin": "{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"}",
      "expect": { "exit_code": 0, "stdout": "", "status": "connect_failed", "response_received": false }
    },
    {
      "name": "claude-pretooluse-null-output",
      "agent": "claude",
      "event": "PreToolUse",
      "daemon": "up",
      "response": "{\"output\":null}",
      "stdin": "{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"}",
      "expect": { "exit_code": 0, "stdout": "", "status": "ok", "response_received": true },
      "expect_request": "{\"agent\":\"claude\",\"deadline_unix_ms\":0,\"event\":\"PreToolUse\",\"payload\":{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"},\"v\":1}"
    },
    {
      "name": "claude-pretooluse-advice-output",
      "agent": "claude",
      "event": "PreToolUse",
      "daemon": "up",
      "response": "{\"output\":{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"[advice]\"}}}",
      "stdin": "{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"}",
      "expect": { "exit_code": 0, "stdout": "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"[advice]\"}}\n", "status": "ok", "response_received": true },
      "expect_request": "{\"agent\":\"claude\",\"deadline_unix_ms\":0,\"event\":\"PreToolUse\",\"payload\":{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"},\"v\":1}"
    },
    {
      "name": "claude-pretooluse-denial-output",
      "agent": "claude",
      "event": "PreToolUse",
      "daemon": "up",
      "response": "{\"output\":{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"repeat\"}}}",
      "stdin": "{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"}",
      "expect": { "exit_code": 0, "stdout": "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"repeat\"}}\n", "status": "ok", "response_received": true },
      "expect_request": "{\"agent\":\"claude\",\"deadline_unix_ms\":0,\"event\":\"PreToolUse\",\"payload\":{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"},\"v\":1}"
    },
    {
      "name": "claude-pretooluse-daemon-error",
      "agent": "claude",
      "event": "PreToolUse",
      "daemon": "up",
      "response": "{\"error\":\"internal failure\"}",
      "stdin": "{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"}",
      "expect": { "exit_code": 0, "stdout": "", "status": "daemon_error", "response_received": true },
      "expect_request": "{\"agent\":\"claude\",\"deadline_unix_ms\":0,\"event\":\"PreToolUse\",\"payload\":{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"},\"v\":1}"
    },
    {
      "name": "claude-pretooluse-unreadable-response",
      "agent": "claude",
      "event": "PreToolUse",
      "daemon": "up",
      "response": "not json at all",
      "stdin": "{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"}",
      "expect": { "exit_code": 0, "stdout": "", "status": "invalid_response", "response_received": false },
      "expect_request": "{\"agent\":\"claude\",\"deadline_unix_ms\":0,\"event\":\"PreToolUse\",\"payload\":{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"},\"v\":1}"
    },
    {
      "name": "claude-pretooluse-delivery-ack",
      "agent": "claude",
      "event": "PreToolUse",
      "daemon": "up",
      "response": "{\"output\":{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"[advice]\"}},\"delivery_token\":\"tok-1\"}",
      "stdin": "{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"}",
      "expect_ack": "{\"delivery_token\":\"tok-1\",\"printed\":true}",
      "expect": { "exit_code": 0, "stdout": "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"[advice]\"}}\n", "status": "ok", "response_received": true },
      "expect_request": "{\"agent\":\"claude\",\"deadline_unix_ms\":0,\"event\":\"PreToolUse\",\"payload\":{\"session_id\":\"contract\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\"},\"v\":1}"
    },
    {
      "name": "cursor-beforeshell-null-output",
      "agent": "cursor",
      "event": "beforeShellExecution",
      "daemon": "up",
      "response": "{\"output\":null}",
      "stdin": "{\"hook_event_name\":\"beforeShellExecution\",\"command\":\"ls\",\"cwd\":\"/tmp\"}",
      "expect": { "exit_code": 0, "stdout": "{\"permission\":\"allow\"}\n", "status": "ok", "response_received": true },
      "expect_request": "{\"agent\":\"cursor\",\"deadline_unix_ms\":0,\"event\":\"beforeShellExecution\",\"payload\":{\"hook_event_name\":\"beforeShellExecution\",\"command\":\"ls\",\"cwd\":\"/tmp\"},\"v\":1}"
    },
